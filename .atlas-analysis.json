  "keyFeatures": [
    "Click-based coffee brewing with progressive click power upgrades",
    "16 buildings from Auto Brewer to Coffee Multiverse, each with 8 upgrade tiers",
    "Prestige system that resets progress but grants permanent Golden Coffee production multipliers",
    "Golden Upgrades for automation (auto-buy, auto-claim achievements) and permanent CPS bonuses",
    "Achievement system with 400+ achievements across coffee milestones, CPS milestones, and building collections",
    "Save export/import via base64 strings for cross-device progress transfer",
    "Extended number support up to trigintillion (10^96) for late-game numbers",
    "Settings panel for notifications, quick keys, and number display format"
  ],
  "publicApiSurface": [
    "buyItem(itemId, amount)",
    "sellItem(itemId, amount)",
    "buyUpgrade(upgradeId)",
    "buyGoldenUpgrade(upgradeId)",
    "doPrestige()",
    "exportSave()",
    "importSave(importString)",
    "eraseProgress()",
    "calculateTotalCPS()",
    "abbreviateNumber(num)",
    "checkAchievements()",
    "claimAchievementReward(achievement)",
    "runAutomation()"
  ]
